---
import { researchHighlights } from '../data/research-highlights';
import Arrow from './Arrow.astro';
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
const highlights = compact
  ? researchHighlights.slice(0, 2)
  : researchHighlights;
---

<section
  class:list={['research-highlights', { 'highlights-compact': compact }]}
  aria-labelledby="research-highlights-title"
>
  <div class="section-heading">
    <div>
      <p class="eyebrow">Evidence behind the work</p>
      <h2 id="research-highlights-title">A few things we’ve learned.</h2>
    </div>
    <a class="text-link" href="/CV.pdf">
      Publications in my CV
      <Arrow />
    </a>
  </div>
  <div class="research-highlight-grid">
    {highlights.map((item) => (
      <article class="research-highlight">
        <p class="eyebrow">{item.label}</p>
        <h3>{item.title}</h3>
        <p class="study-method">{item.method}</p>
        <p>{item.finding}</p>
        {!compact && (
          <div class="research-implication">
            <span>What I take from it</span>
            <p>{item.implication}</p>
          </div>
        )}
        <div class="paper-link">
          <a href={item.href}>
            {item.paper}
            <span class="file-label">PDF</span>
            <Arrow diagonal />
          </a>
          <span>{item.attribution}</span>
        </div>
      </article>
    ))}
  </div>
</section>
