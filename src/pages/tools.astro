---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
---

<Base
  title="Tools"
  active="Tools"
  description="A couple of things I made for fun: Disney Channel Original Movie bingo and a wood tile image planner."
  dark
>
  <section class="page-hero dark">
    <div class="container">
      <p class="eyebrow">Away from the research</p>
      <h1>
        A few things <em>I made for fun.</em>
      </h1>
      <p class="page-lead">
        Small tools for watching movies and making things.
      </p>
    </div>
  </section>
  <section class="section">
    <div class="container directory-grid">
      <a class="directory-card" id="dcom-bingo" href="/dcom-bingo.html">
        <p class="eyebrow">Movies</p>
        <h2>DCOM Bingo.</h2>
        <p>
          I watched every Disney Channel Original Movie with a friend. We kept a
          list of the tropes. This is what happened next.
        </p>
        <span class="text-link">
          Play DCOM Bingo <Arrow />
        </span>
      </a>
      <a
        class="directory-card"
        id="wood-tile-studio"
        href="/wood-tile-studio.html"
      >
        <p class="eyebrow">Making things</p>
        <h2>Wood Tile Studio.</h2>
        <p>
          Turn an image into square tiles you can print, paint, and assemble.
        </p>
        <span class="text-link">
          Open Wood Tile Studio <Arrow />
        </span>
      </a>
    </div>
  </section>
</Base>
